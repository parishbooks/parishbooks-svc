# Copy to `.env.e2e` at the repo root.
#
# One-time DB prep (creates `parishbooks_e2e` if needed, then migrates):
#   createdb parishbooks_e2e   # or equivalent
#   bun --env-file=.env.e2e nx run database:typeorm-migrate
#
# E2E boots Nest apps in-process via Supertest (`@parishbooks/e2e-supertest`).
# You do not need to start services manually. Auth e2e still listens on ORG_SERVICE_PORT
# for auth→org HTTP calls. Ensure those ports are free (8011, 8017 by default).
#
# Run e2e (Jest loads `.env.e2e` from the repo root):
#   nx run parishbooks-auth-svc-e2e:e2e
#   nx e2e parishbooks-auth-svc
#
# Uses dedicated ports and database so dev servers on 800x stay untouched.

BETTER_AUTH_SECRET="e2e-better-auth-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:8011"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parishbooks_e2e"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

STRIPE_SECRET_KEY="sk_test_e2e_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_e2e_placeholder"
STRIPE_STARTER_PRICE_ID="price_e2e_starter"
STRIPE_PRO_PRICE_ID="price_e2e_pro"

CASHFREE_API_BASE_URL="https://sandbox.cashfree.com"
CASHFREE_CLIENT_ID="cf_e2e_client_id"
CASHFREE_CLIENT_SECRET="cf_e2e_client_secret"
CASHFREE_WEBHOOK_SECRET="cf_e2e_webhook_secret"

INTERNAL_SERVICE_KEY="e2e-internal-service-key"
RESEND_API_KEY="re_e2e_placeholder"
RESEND_FROM_EMAIL="e2e@parishbooks.test"

AUTH_SERVICE_PORT=8011
ORG_SERVICE_PORT=8017

AUTH_SERVICE_URL="http://localhost:8011/api"
ORG_SERVICE_URL="http://localhost:8017/api"

BILLING_SERVICE_URL="http://127.0.0.1:8012/api"
MEMBER_SERVICE_URL="http://127.0.0.1:8013/api"
EVENTS_SERVICE_URL="http://127.0.0.1:8014/api"
GIVING_SERVICE_URL="http://127.0.0.1:8015/api"
LEDGER_SERVICE_URL="http://127.0.0.1:8016/api"

E2E_TEST_PASSWORD="password123"
