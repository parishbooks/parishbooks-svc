{
    "name": "database",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/database/src",
    "projectType": "library",
    "tags": ["scope:shared"],
    "// targets": "to see all targets run: nx show project database --web",
    "targets": {
        "typeorm-generate": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bun scripts/typeorm-generate.ts",
                "cwd": "packages/database"
            }
        },
        "typeorm-migrate": {
            "executor": "nx:run-commands",
            "options": {
                "command": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
                "cwd": "packages/database",
                "env": { "TS_NODE_PROJECT": "tsconfig.lib.json" }
            }
        }
    }
}
