{
    "name": "@parishbooks/parishbooks-giving-svc-e2e",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "name": "parishbooks-giving-svc-e2e",
        "implicitDependencies": [
            "parishbooks-giving-svc"
        ],
        "targets": {
            "e2e": {
                "executor": "@nx/jest:jest",
                "outputs": [
                    "{projectRoot}/test-output/jest/coverage"
                ],
                "dependsOn": [
                    "parishbooks-giving-svc:build",
                    "parishbooks-giving-svc:serve"
                ],
                "options": {
                    "jestConfig": "apps/parishbooks-giving-svc-e2e/jest.config.cts",
                    "passWithNoTests": true
                }
            }
        }
    }
}
