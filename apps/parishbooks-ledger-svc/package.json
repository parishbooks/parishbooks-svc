{
    "name": "@parishbooks/parishbooks-ledger-svc",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "name": "parishbooks-ledger-svc",
        "targets": {
            "build": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "webpack-cli build",
                    "env": {
                        "NODE_ENV": "production"
                    },
                    "cwd": "apps/parishbooks-ledger-svc"
                },
                "configurations": {
                    "development": {
                        "env": {
                            "NODE_ENV": "development"
                        }
                    }
                }
            },
            "prune-lockfile": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "executor": "@nx/js:prune-lockfile",
                "outputs": [
                    "{workspaceRoot}/apps/parishbooks-ledger-svc/dist/package.json",
                    "{workspaceRoot}/apps/parishbooks-ledger-svc/dist/bun.lock"
                ],
                "options": {
                    "buildTarget": "build"
                }
            },
            "copy-workspace-modules": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "outputs": [
                    "{workspaceRoot}/apps/parishbooks-ledger-svc/dist/workspace_modules"
                ],
                "executor": "@nx/js:copy-workspace-modules",
                "options": {
                    "buildTarget": "build"
                }
            },
            "prune": {
                "dependsOn": [
                    "prune-lockfile",
                    "copy-workspace-modules"
                ],
                "executor": "nx:noop"
            },
            "serve": {
                "continuous": true,
                "executor": "@nx/js:node",
                "defaultConfiguration": "development",
                "dependsOn": [
                    "build"
                ],
                "options": {
                    "buildTarget": "parishbooks-ledger-svc:build",
                    "runBuildTargetDependencies": false
                },
                "configurations": {
                    "development": {
                        "buildTarget": "parishbooks-ledger-svc:build:development"
                    },
                    "production": {
                        "buildTarget": "parishbooks-ledger-svc:build:production"
                    }
                }
            },
            "test": {
                "options": {
                    "passWithNoTests": true
                }
            },
            "docker:build": {
                "dependsOn": [
                    "build",
                    "prune"
                ]
            }
        },
        "tags": [
            "scope:app"
        ]
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0",
        "tslib": "^2.3.0",
        "@parishbooks/core": "workspace:*"
    },
    "devDependencies": {
        "@nestjs/testing": "^11.0.0"
    }
}
