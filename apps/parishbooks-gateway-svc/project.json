{
    "name": "parishbooks-gateway-svc",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/parishbooks-gateway-svc/src",
    "projectType": "application",
    "tags": [
        "scope:parishbooks-gateway-svc",
        "type:app"
    ],
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "webpack-cli build",
                "env": {
                    "NODE_ENV": "production"
                },
                "cwd": "apps/parishbooks-gateway-svc"
            },
            "configurations": {
                "development": {
                    "env": {
                        "NODE_ENV": "development"
                    }
                }
            }
        },
        "prune-lockfile": {
            "dependsOn": [
                "build"
            ],
            "cache": true,
            "executor": "@nx/js:prune-lockfile",
            "outputs": [
                "{workspaceRoot}/apps/parishbooks-gateway-svc/dist/package.json",
                "{workspaceRoot}/apps/parishbooks-gateway-svc/dist/bun.lock"
            ],
            "options": {
                "buildTarget": "build"
            }
        },
        "copy-workspace-modules": {
            "dependsOn": [
                "build"
            ],
            "cache": true,
            "outputs": [
                "{workspaceRoot}/apps/parishbooks-gateway-svc/dist/workspace_modules"
            ],
            "executor": "@nx/js:copy-workspace-modules",
            "options": {
                "buildTarget": "build"
            }
        },
        "prune": {
            "dependsOn": [
                "prune-lockfile",
                "copy-workspace-modules"
            ],
            "executor": "nx:noop"
        },
        "serve": {
            "continuous": true,
            "executor": "@nx/js:node",
            "defaultConfiguration": "development",
            "dependsOn": [
                "build"
            ],
            "options": {
                "buildTarget": "parishbooks-gateway-svc:build",
                "runBuildTargetDependencies": false
            },
            "configurations": {
                "development": {
                    "buildTarget": "parishbooks-gateway-svc:build:development"
                },
                "production": {
                    "buildTarget": "parishbooks-gateway-svc:build:production"
                },
                "e2e": {
                    "buildTarget": "parishbooks-gateway-svc:build:development",
                    "watch": false
                }
            }
        },
        "serve-e2e": {
            "continuous": true,
            "executor": "nx:run-commands",
            "dependsOn": ["build:development"],
            "options": {
                "command": "bun e2e/shared/run-service.ts apps/parishbooks-gateway-svc/dist/main.js"
            }
        },
        "test": {
            "options": {
                "passWithNoTests": true
            }
        },
        "e2e": {
            "executor": "nx:run-commands",
            "options": {
                "command": "nx run parishbooks-gateway-svc-e2e:e2e --output-style=stream"
            }
        }
    }
}
