{
    "name": "@parishbooks/parishbooks-billing-svc-e2e",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "name": "parishbooks-billing-svc-e2e",
        "implicitDependencies": [
            "parishbooks-billing-svc"
        ],
        "targets": {
            "e2e": {
                "executor": "@nx/jest:jest",
                "outputs": [
                    "{projectRoot}/test-output/jest/coverage"
                ],
                "options": {
                    "jestConfig": "e2e/parishbooks-billing-svc-e2e/jest.config.js",
                    "passWithNoTests": true
                }
            }
        }
    },
    "dependencies": {
        "@parishbooks/core": "workspace:*",
        "@parishbooks/e2e-supertest": "workspace:*"
    }
}
