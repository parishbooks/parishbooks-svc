{
    "name": "@parishbooks/parishbooks-auth-svc-e2e",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "name": "parishbooks-auth-svc-e2e",
        "implicitDependencies": [
            "parishbooks-auth-svc",
            "parishbooks-org-svc"
        ],
        "targets": {
            "e2e": {
                "executor": "@nx/jest:jest",
                "outputs": [
                    "{projectRoot}/test-output/jest/coverage"
                ],
                "options": {
                    "jestConfig": "e2e/parishbooks-auth-svc-e2e/jest.config.js",
                    "passWithNoTests": false
                }
            }
        }
    },
    "dependencies": {
        "@parishbooks/e2e-support": "workspace:*"
    }
}
