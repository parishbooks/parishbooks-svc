{
    "name": "@parishbooks/parishbooks-member-svc-e2e",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "name": "parishbooks-member-svc-e2e",
        "implicitDependencies": [
            "parishbooks-member-svc"
        ],
        "targets": {
            "e2e": {
                "executor": "@nx/jest:jest",
                "outputs": [
                    "{projectRoot}/test-output/jest/coverage"
                ],
                "dependsOn": [
                    "parishbooks-member-svc:build",
                    "parishbooks-member-svc:serve:e2e"
                ],
                "options": {
                    "jestConfig": "e2e/parishbooks-member-svc-e2e/jest.config.cts",
                    "passWithNoTests": true
                }
            }
        }
    }
}
