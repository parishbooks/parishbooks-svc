{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "../..",
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "emitDeclarationOnly": false,
        "noEmit": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "noUnusedLocals": false,
        "noImplicitAny": false,
        "types": ["jest", "node"]
    }
}
